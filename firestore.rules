rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'vishaal.s.1078@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin')
      );
    }

    function isOrgMember(orgId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/organizations/$(orgId)) &&
         get(/databases/$(database)/documents/organizations/$(orgId)).data.headUserId == request.auth.uid)
      );
    }

    function isOrgHead(orgId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/organizations/$(orgId)) &&
         get(/databases/$(database)/documents/organizations/$(orgId)).data.headUserId == request.auth.uid) ||
        (exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role == 'org_head')
      );
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // Test connection doc
    match /test/{testId} {
      allow read, write: if true;
    }

    // Organizations
    match /organizations/{orgId} {
      // Super admin can read all organizations; members can read their own
      allow read: if isOrgMember(orgId);
      // Only Super Admin can create or delete organizations
      allow create, delete: if isSuperAdmin();
      // Org head and super admin can update organization details
      allow update: if isOrgHead(orgId);

      // Members subcollection
      match /members/{memberId} {
        allow read: if isOrgMember(orgId);
        allow create, update, delete: if isOrgHead(orgId);
      }

      // Safeguard Staged Actions subcollection
      match /stagedActions/{actionId} {
        allow read, write: if isOrgMember(orgId);
      }

      // CRM Contacts subcollection
      match /crmContacts/{contactId} {
        allow read, write: if isOrgMember(orgId);
      }

      // Calendar Events subcollection
      match /calendarEvents/{eventId} {
        allow read, write: if isOrgMember(orgId);
      }

      // Emails subcollection (Real-time email data)
      match /emails/{emailId} {
        allow read, write: if isOrgMember(orgId);
      }

      // Cryptographic Audit Logs subcollection
      match /auditLogs/{logId} {
        allow read: if isOrgMember(orgId);
        allow create: if isOrgMember(orgId);
        allow update, delete: if false; // Immutable audit trail
      }
    }
  }
}
